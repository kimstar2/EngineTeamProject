    <Name>k__BackingField: ???
    <Message>k__BackingField: "\uC548\uB155\uD558\uC138\uC694! Adventure OS \uC5D0
      \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!"
    <UseEvent>k__BackingField: 0
