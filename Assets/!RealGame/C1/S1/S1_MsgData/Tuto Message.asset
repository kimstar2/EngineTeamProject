  - <AnimHash>k__BackingField: {fileID: 11400000, guid: 6da273a9b48c6ae4cac0c0a7df09b7c8, type: 2}
    <Name>k__BackingField: "\uBCA4\uCCD0"
    <Message>k__BackingField: "\uC800\uB294 <color=#00ffff>\uBCA4\uCCD0</color>\uB77C\uACE0
      \uD574\uC694.\n\uACC1\uC5D0\uC11C \uD50C\uB808\uC774\uC5B4\uB2D8\uC744 \uB3C4\uC6B8
      \uB3C4\uC6B0\uBBF8 \uC5ED\uD560\uC744 \uD558\uACE0 \uC788\uC5B4\uC694!!"
    <UseEvent>k__BackingField: 0
    <Event>k__BackingField: {fileID: 11400000, guid: 11f05f0cc754bfd40845d6b6ace168ce, type: 2}
    <UseAdvanceEvent>k__BackingField: 0
    <AdvanceEvent>k__BackingField: {fileID: 11400000, guid: 47c8faa28754cbb4fb5111a8683a889c, type: 2}
  - <AnimHash>k__BackingField: {fileID: 11400000, guid: 6da273a9b48c6ae4cac0c0a7df09b7c8, type: 2}
    <Name>k__BackingField: "\uBCA4\uCCD0"
    <Message>k__BackingField: "\uAC8C\uC784\uC744 \uC9C4\uD589\uD558\uB2E4\uAC00
      \uB0AF\uC120 \uD37C\uC990\uC774 \uB098\uC654\uC744 \uB54C,\n\uC124\uBA85\uD558\uB294
      \uC5ED\uD560\uC744 \uD558\uB294 \uC148\uC774\uC8E0."
    <UseEvent>k__BackingField: 0
    <Event>k__BackingField: {fileID: 11400000, guid: 11f05f0cc754bfd40845d6b6ace168ce, type: 2}
    <UseAdvanceEvent>k__BackingField: 0
    <AdvanceEvent>k__BackingField: {fileID: 11400000, guid: 47c8faa28754cbb4fb5111a8683a889c, type: 2}
  - <AnimHash>k__BackingField: {fileID: 11400000, guid: 6da273a9b48c6ae4cac0c0a7df09b7c8, type: 2}
    <Name>k__BackingField: "\uBCA4\uCCD0"
    <Message>k__BackingField: "\uC88C\uCE21 \uC544\uB798 <rainb>Start</rainb> \uBCF4\uC774\uC2DC\uC8E0?!\n\uC800\uAE38
      \uD074\uB9AD\uD558\uACE0 \uC81C \uC774\uB984\uC778 <color=#00ffff>\uBCA4\uCCD0</color>
      \uB97C \uD074\uB9AD\uD558\uBA74 \uC81C\uAC00 \uB098\uC640\uC694!"
    <UseEvent>k__BackingField: 1
    <Event>k__BackingField: {fileID: 11400000, guid: a871b925817c3e64987dbaf584a2a362, type: 2}
    <UseAdvanceEvent>k__BackingField: 0
    <AdvanceEvent>k__BackingField: {fileID: 11400000, guid: 47c8faa28754cbb4fb5111a8683a889c, type: 2}
  - <AnimHash>k__BackingField: {fileID: 11400000, guid: 6da273a9b48c6ae4cac0c0a7df09b7c8, type: 2}
    <Name>k__BackingField: "\uBCA4\uCCD0"
    <Message>k__BackingField: "\uC800\uB294 \uADF8\uB54C\uC5D0 \uD37C\uC990\uC5D0
      \uB9DE\uCDB0\uC11C \uB2E8\uC11C\uB098 \uD78C\uD2B8\uB97C \uC81C\uACF5\uD558\uB294\n\uC5ED\uD560\uC744
      \uD574\uC694! \uAF64\uB098 \uC88B\uB2F5\uB2C8\uB2E4?"
